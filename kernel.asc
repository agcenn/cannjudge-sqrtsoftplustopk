#include <cmath>
#include "kernel_operator.h"

// A2/dav2201: batch independent rows through Sort32 and bounded four-way
// merge stages. Each row has 32 * 4^n elements, so a merge never spans rows.
namespace sqrtsoftplus_pruned_pow2 {
using namespace AscendC;

constexpr float kNegative = -3.402823466e+38F;

template <typename T>
__aicore__ inline uint32_t AlignElements(uint32_t n)
{
    constexpr uint32_t block = 32u / sizeof(T);
    return (n + block - 1u) / block * block;
}

template <typename T>
__aicore__ inline T Negative();
template <>
__aicore__ inline float Negative<float>() { return kNegative; }
template <>
__aicore__ inline half Negative<half>() { return static_cast<half>(-65504.0F); }

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                uint32_t rows, uint32_t experts, uint32_t topk)
    {
        rows_ = rows;
        experts_ = experts;
        topk_ = topk;
        // Pad only to the next power of two. Rows with 2, 8, or 32 initial
        // runs use one two-way stage, then all remaining stages are four-way.
        padded_ = 64u;
        while (padded_ < experts_) {
            padded_ *= 2u;
        }
        batchRows_ = 4096u / padded_;
        if (batchRows_ > 64u) batchRows_ = 64u;
        const uint32_t cores = GetBlockNum();
        const uint32_t rowsPerCore = (rows_ + cores - 1u) / cores;
        if (batchRows_ > rowsPerCore) batchRows_ = rowsPerCore;
        if (batchRows_ == 0u) batchRows_ = 1u;
        // For FP16 every row is 16 values/32B aligned. FP32 needs 8 values.
        outputStride_ = AlignElements<T>(topk_);
        uint32_t tile = batchRows_ * padded_;
        uint32_t scores = batchRows_ * outputStride_;

        // Depth-2 queues double the DMA buffers so the next batch's copy
        // overlaps this batch's compute.  Halve the batch while the
        // estimated UB footprint exceeds a conservative A2 budget.
        uint32_t estimated = 2u * tile * sizeof(T) + 2u * scores * sizeof(T)
            + tile * 4u + 4u * tile * 4u + tile * 4u + 3u * scores * 4u;
        while (estimated > 200u * 1024u && batchRows_ > 1u) {
            batchRows_ /= 2u;
            tile = batchRows_ * padded_;
            scores = batchRows_ * outputStride_;
            estimated = 2u * tile * sizeof(T) + 2u * scores * sizeof(T)
                + tile * 4u + 4u * tile * 4u + tile * 4u + 3u * scores * 4u;
        }

        input_.SetGlobalBuffer((__gm__ T *)input,
                                static_cast<uint64_t>(rows_) * experts_);
        output_.SetGlobalBuffer((__gm__ T *)output,
                                 static_cast<uint64_t>(rows_) * topk_);
        pipe_.InitBuffer(inputQ_, 2, tile * sizeof(T));
        pipe_.InitBuffer(outputQ_, 2, scores * sizeof(T));
        pipe_.InitBuffer(valuesBuf_, tile * sizeof(float));
        pipe_.InitBuffer(sortABuf_, 2u * tile * sizeof(float));
        pipe_.InitBuffer(sortBBuf_, 2u * tile * sizeof(float));
        pipe_.InitBuffer(indexBuf_, tile * sizeof(uint32_t));
        pipe_.InitBuffer(scoresBuf_, scores * sizeof(float));
        pipe_.InitBuffer(mathABuf_, scores * sizeof(float));
        pipe_.InitBuffer(mathBBuf_, scores * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<uint32_t> index = indexBuf_.Get<uint32_t>();
        // Indices are not returned, but Sort32 consumes one for every input.
        // Initialize once per core instead of once per row or batch.
        ArithProgression<int32_t>(index.ReinterpretCast<int32_t>(), 0, 1,
                                  static_cast<int32_t>(batchRows_ * padded_));
        PipeBarrier<PIPE_V>();
        const uint32_t step = GetBlockNum() * batchRows_;
        uint32_t row = GetBlockIdx() * batchRows_;
        if (row >= rows_) return;
        // Software-pipelined loop over row batches: with depth-2 queues,
        // CopyIn(batch i+1) runs while Compute/CopyOut(batch i) executes.
        const uint32_t firstRemain = rows_ - row;
        CopyIn(row, firstRemain < batchRows_ ? firstRemain : batchRows_);
        for (;;) {
            const uint32_t remain = rows_ - row;
            const uint32_t batch = remain < batchRows_ ? remain : batchRows_;
            const uint32_t nextRow = row + step;
            if (nextRow < rows_) {
                const uint32_t nextRemain = rows_ - nextRow;
                const uint32_t nextBatch =
                    nextRemain < batchRows_ ? nextRemain : batchRows_;
                CopyIn(nextRow, nextBatch);
            }
            Compute(batch, index);
            CopyOut(row, batch);
            if (nextRow >= rows_) break;
            row = nextRow;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t row, uint32_t batch)
    {
        LocalTensor<T> local = inputQ_.AllocTensor<T>();
        // DataCopyPad only pads the final 32B block. Initialize the larger
        // per-row gaps first, then copy all B compact GM rows in one DMA.
        Duplicate<T>(local, Negative<T>(), batch * padded_);
        const int32_t event = static_cast<int32_t>(pipe_.FetchEventID(HardEvent::V_MTE2));
        SetFlag<HardEvent::V_MTE2>(event);
        WaitFlag<HardEvent::V_MTE2>(event);
        const uint32_t aligned = AlignElements<T>(experts_);
        DataCopyExtParams copy = {
            static_cast<uint16_t>(batch), static_cast<uint32_t>(experts_ * sizeof(T)), 0,
            static_cast<uint32_t>((padded_ - aligned) * sizeof(T) / 32u), 0};
        DataCopyPadExtParams<T> pad = {
            true, 0, static_cast<uint8_t>(aligned - experts_), Negative<T>()};
        DataCopyPad(local, input_[static_cast<uint64_t>(row) * experts_], copy, pad);
        inputQ_.EnQue(local);
    }

    __aicore__ inline void Convert(LocalTensor<float> &dst,
                                   LocalTensor<float> &src, uint32_t count)
    {
        DataCopy(dst, src, count);
    }

    __aicore__ inline void Convert(LocalTensor<float> &dst,
                                   LocalTensor<half> &src, uint32_t count)
    {
        Cast(dst, src, RoundMode::CAST_NONE, count);
    }

    __aicore__ inline void Store(LocalTensor<float> &dst,
                                 LocalTensor<float> &src, uint32_t count)
    {
        DataCopy(dst, src, count);
    }

    __aicore__ inline void Store(LocalTensor<half> &dst,
                                 LocalTensor<float> &src, uint32_t count)
    {
        Cast(dst, src, RoundMode::CAST_NONE, count);
    }

    __aicore__ inline void Compute(uint32_t batch, LocalTensor<uint32_t> &index)
    {
        LocalTensor<T> input = inputQ_.DeQue<T>();
        LocalTensor<float> values = valuesBuf_.Get<float>();
        LocalTensor<float> sortA = sortABuf_.Get<float>();
        LocalTensor<float> sortB = sortBBuf_.Get<float>();
        LocalTensor<float> scores = scoresBuf_.Get<float>();
        LocalTensor<float> mathA = mathABuf_.Get<float>();
        LocalTensor<float> mathB = mathBBuf_.Get<float>();
        const uint32_t tile = batch * padded_;
        Convert(values, input, tile);
        PipeBarrier<PIPE_V>();
        Sort32<float>(sortA, values, index, static_cast<int32_t>(tile / 32u));
        PipeBarrier<PIPE_V>();

        // Only the first aligned top-k pairs from each sorted run can enter
        // the row's final top-k. Compact after every merge so later stages
        // never move the discarded tail.
        const uint32_t retained = outputStride_;
        uint32_t length = retained < 32u ? retained : 32u;
        const uint32_t runCount = tile / 32u;
        DataCopyParams initialCompact = {
            static_cast<uint16_t>(runCount),
            static_cast<uint16_t>(length / 4u),
            static_cast<uint16_t>(8u - length / 4u), 0};
        DataCopy(sortB, sortA, initialCompact);
        PipeBarrier<PIPE_V>();

        LocalTensor<float> sorted = sortB;
        LocalTensor<float> scratch = sortA;
        uint32_t listsPerRow = padded_ / 32u;
        while (listsPerRow > 1u) {
            const uint32_t fanIn = (listsPerRow & 3u) == 0u ? 4u : 2u;
            const uint32_t groupsPerRow = listsPerRow / fanIn;
            const uint32_t totalGroups = batch * groupsPerRow;
            MrgSort4Info params;
            params.elementLengths[0] = static_cast<uint16_t>(length);
            params.elementLengths[1] = static_cast<uint16_t>(length);
            params.elementLengths[2] = fanIn == 4u ? static_cast<uint16_t>(length) : 0;
            params.elementLengths[3] = fanIn == 4u ? static_cast<uint16_t>(length) : 0;
            params.ifExhaustedSuspension = false;
            params.validBit = fanIn == 4u ? 15 : 3;
            if (fanIn == 4u) {
                MrgSortSrcList<float> lists;
                lists.src1 = sorted[0];
                lists.src2 = sorted[2u * length];
                lists.src3 = sorted[4u * length];
                lists.src4 = sorted[6u * length];
                params.repeatTimes = static_cast<uint16_t>(totalGroups);
                MrgSort<float>(scratch, lists, params);
            } else {
                // A2's two-way mode does not advance compact repeated source
                // groups like its four-way mode.  Issue one merge per group;
                // the power-of-two layout has at most 64 such groups.
                params.repeatTimes = 1;
                const uint32_t groupFloats = 4u * length;
                for (uint32_t group = 0; group < totalGroups; ++group) {
                    const uint32_t base = group * groupFloats;
                    MrgSortSrcList<float> lists;
                    lists.src1 = sorted[base];
                    lists.src2 = sorted[base + 2u * length];
                    lists.src3 = sorted[base];
                    lists.src4 = sorted[base];
                    MrgSort<float>(scratch[base], lists, params);
                }
            }
            PipeBarrier<PIPE_V>();

            const uint32_t mergedLength = fanIn * length;
            const uint32_t nextLength = mergedLength < retained ? mergedLength : retained;
            const uint32_t sourceBlocks = fanIn * length / 4u;
            DataCopyParams compact = {
                static_cast<uint16_t>(totalGroups),
                static_cast<uint16_t>(nextLength / 4u),
                static_cast<uint16_t>(sourceBlocks - nextLength / 4u), 0};
            DataCopy(sorted, scratch, compact);
            PipeBarrier<PIPE_V>();
            length = nextLength;
            listsPerRow = groupsPerRow;
        }

        // Sort32/MrgSort store [score,index] pairs. On A2 counter-mode
        // GatherMask, mask is the input element count PER repeat. Pattern 1
        // takes even lanes, and the repeat stride starts the next row.
        GatherMaskParams gather;
        gather.src0BlockStride = 1;
        gather.repeatTimes = static_cast<uint16_t>(batch);
        gather.src0RepeatStride = static_cast<uint16_t>(retained / 4u);
        gather.src1RepeatStride = 0;
        uint64_t gathered = 0;
        GatherMask(scores, sorted, static_cast<uint8_t>(1), true,
                    2u * outputStride_, gather, gathered);
        PipeBarrier<PIPE_V>();

        // The transform is monotonic, so only sorted top-k logits need math.
        const uint32_t count = batch * outputStride_;
        Abs(mathA, scores, count);
        PipeBarrier<PIPE_V>();
        Muls(mathB, mathA, -1.0F, count);
        PipeBarrier<PIPE_V>();
        Exp(mathA, mathB, count);
        PipeBarrier<PIPE_V>();
        Adds(mathB, mathA, 1.0F, count);
        PipeBarrier<PIPE_V>();
        Log(mathA, mathB, count);
        PipeBarrier<PIPE_V>();
        Maxs(mathB, scores, 0.0F, count);
        PipeBarrier<PIPE_V>();
        Add(scores, mathB, mathA, count);
        PipeBarrier<PIPE_V>();
        Sqrt(mathB, scores, count);
        PipeBarrier<PIPE_V>();
        LocalTensor<T> output = outputQ_.AllocTensor<T>();
        Store(output, mathB, count);
        outputQ_.EnQue(output);
        inputQ_.FreeTensor(input);
    }

    __aicore__ inline void CopyOut(uint32_t row, uint32_t batch)
    {
        LocalTensor<T> output = outputQ_.DeQue<T>();
        // UB stride follows its padded 32B row; GM rows have exactly k values.
        DataCopyExtParams copy = {
            static_cast<uint16_t>(batch), static_cast<uint32_t>(topk_ * sizeof(T)), 0, 0, 0};
        DataCopyPad(output_[static_cast<uint64_t>(row) * topk_], output, copy);
        outputQ_.FreeTensor(output);
    }

    uint32_t rows_ = 0;
    uint32_t experts_ = 0;
    uint32_t topk_ = 0;
    uint32_t padded_ = 0;
    uint32_t batchRows_ = 0;
    uint32_t outputStride_ = 0;
    GlobalTensor<T> input_;
    GlobalTensor<T> output_;
    TPipe pipe_;
    TQue<TPosition::VECIN, 2> inputQ_;
    TQue<TPosition::VECOUT, 2> outputQ_;
    TBuf<TPosition::VECCALC> valuesBuf_, sortABuf_, sortBBuf_, indexBuf_;
    TBuf<TPosition::VECCALC> scoresBuf_, mathABuf_, mathBBuf_;
};

template <typename T>
__aicore__ inline void Run(GM_ADDR input, GM_ADDR output, uint32_t rows,
                           uint32_t experts, uint32_t topk)
{
    Kernel<T> op;
    op.Init(input, output, rows, experts, topk);
    op.Process();
}
} // namespace sqrtsoftplus_pruned_pow2


// FP16 fixed-capacity adaptive filter.  Two 32-value samples per row (blocks
// [0,32) and [32,64)) are sorted in one batched Sort32; the lower of the two
// 4th-largest sample values thresholds the row.  Candidates >= threshold are
// gathered, compacted per row into a fixed CAP-slot layout, and the WHOLE
// BATCH is sorted with a single Sort32 call (restoring the cross-row pipeline
// the per-row variable-length sort destroyed).  Rows whose candidate count is
// below k (too few candidates) or above CAP (cannot truncate unsorted
// candidates) fall back to a per-row full sort; that fallback is exact for
// any input distribution, including ties.
namespace sqrtsoftplus_fixedcap_half {
using namespace AscendC;

constexpr float kNegative = -3.402823466e+38F;
constexpr uint32_t kSampleRank = 4u;  // 4th-largest of each 32-value sample

__aicore__ inline uint32_t AlignHalf(uint32_t n)
{
    return (n + 15u) & ~15u;
}

__aicore__ inline uint32_t AlignFloat(uint32_t n)
{
    return (n + 7u) & ~7u;
}

__aicore__ inline half HalfFromBits(uint16_t bits)
{
    return *reinterpret_cast<half *>(&bits);
}

class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                uint32_t rows, uint32_t experts, uint32_t topk)
    {
        rows_ = rows;
        experts_ = experts;
        topk_ = topk;
        // CompareScalar's count API needs an integral 256-byte span.  Padding
        // to 128 half values also leaves every custom GatherMask mask aligned.
        padded_ = 128u;
        while (padded_ < experts_) padded_ *= 2u;
        outputStride_ = AlignHalf(topk_);
        scoreStride_ = AlignFloat(topk_);
        maskStride_ = ((padded_ + 255u) / 256u) * 32u;
        batchRows_ = 8192u / padded_;
        if (batchRows_ > 32u) batchRows_ = 32u;
        const uint32_t rowsPerCore =
            (rows_ + GetBlockNum() - 1u) / GetBlockNum();
        if (batchRows_ > rowsPerCore) batchRows_ = rowsPerCore;
        if (batchRows_ == 0u) batchRows_ = 1u;
        const uint32_t tile = batchRows_ * padded_;
        const uint32_t scoreTile = batchRows_ * scoreStride_;

        // Fixed candidate capacity per row.  Sized from the offline
        // candidate-count statistics of the dual rank-4 policy: P(count>CAP)
        // stays in single-digit percent for the gated shapes, and those rows
        // take the per-row variable fallback.
        if (experts_ == 256u && topk_ == 16u) {
            cap_ = 64u;
        } else if (experts_ == 512u && topk_ == 32u) {
            cap_ = 128u;
        } else {
            cap_ = 256u;
        }

        input_.SetGlobalBuffer((__gm__ half *)input,
                               static_cast<uint64_t>(rows_) * experts_);
        output_.SetGlobalBuffer((__gm__ half *)output,
                                static_cast<uint64_t>(rows_) * topk_);
        pipe_.InitBuffer(inputQ_, 2, tile * sizeof(half));
        pipe_.InitBuffer(outputQ_, 1,
                         batchRows_ * outputStride_ * sizeof(half));
        pipe_.InitBuffer(maskBuf_, batchRows_ * maskStride_);
        pipe_.InitBuffer(candidateBuf_, tile * sizeof(half));
        pipe_.InitBuffer(fastFloatBuf_, batchRows_ * cap_ * sizeof(float));
        pipe_.InitBuffer(fastSortBuf_, 2u * batchRows_ * cap_ * sizeof(float));
        pipe_.InitBuffer(fastSortBBuf_, 2u * batchRows_ * cap_ * sizeof(float));
        pipe_.InitBuffer(fastIndexBuf_, batchRows_ * cap_ * sizeof(uint32_t));
        pipe_.InitBuffer(scoresBuf_, scoreTile * sizeof(float));
        pipe_.InitBuffer(mathABuf_, scoreTile * sizeof(float));
        pipe_.InitBuffer(mathBBuf_, scoreTile * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // One progression serves the sample sort, the fixed-capacity sort,
        // and the per-row fallback sort (prefixes of 0..batchRows_*cap_).
        LocalTensor<uint32_t> fastIndex = fastIndexBuf_.Get<uint32_t>();
        ArithProgression<int32_t>(fastIndex.ReinterpretCast<int32_t>(), 0, 1,
                                  static_cast<int32_t>(batchRows_ * cap_));
        PipeBarrier<PIPE_V>();
        // Software-pipelined loop over row batches: with a depth-2 input
        // queue, CopyIn(batch i+1) runs while Compute/CopyOut(batch i)
        // executes, hiding the row DMA behind the sort work.
        const uint32_t step = GetBlockNum() * batchRows_;
        uint32_t row = GetBlockIdx() * batchRows_;
        if (row >= rows_) return;
        const uint32_t firstRemain = rows_ - row;
        CopyIn(row, firstRemain < batchRows_ ? firstRemain : batchRows_);
        for (;;) {
            const uint32_t remain = rows_ - row;
            const uint32_t batch = remain < batchRows_ ? remain : batchRows_;
            const uint32_t nextRow = row + step;
            if (nextRow < rows_) {
                const uint32_t nextRemain = rows_ - nextRow;
                const uint32_t nextBatch =
                    nextRemain < batchRows_ ? nextRemain : batchRows_;
                CopyIn(nextRow, nextBatch);
            }
            Compute(batch, fastIndex);
            CopyOut(row, batch);
            if (nextRow >= rows_) break;
            row = nextRow;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t row, uint32_t batch)
    {
        LocalTensor<half> local = inputQ_.AllocTensor<half>();
        Duplicate(local, HalfFromBits(0xfc00u), batch * padded_);
        const int32_t event = static_cast<int32_t>(
            pipe_.FetchEventID(HardEvent::V_MTE2));
        SetFlag<HardEvent::V_MTE2>(event);
        WaitFlag<HardEvent::V_MTE2>(event);
        const uint32_t aligned = AlignHalf(experts_);
        DataCopyExtParams copy = {
            static_cast<uint16_t>(batch),
            static_cast<uint32_t>(experts_ * sizeof(half)), 0,
            static_cast<uint32_t>((padded_ - aligned) * sizeof(half) / 32u), 0};
        DataCopyPadExtParams<half> pad = {
            true, 0, static_cast<uint8_t>(aligned - experts_),
            HalfFromBits(0xfc00u)};
        DataCopyPad(local, input_[static_cast<uint64_t>(row) * experts_],
                    copy, pad);
        inputQ_.EnQue(local);
    }

    // Exact per-row fallback: sort `sortSource` (candidateCount values, the
    // region pre-padded with kNegative beyond the count), take the top
    // scoreStride_, and gather the values into the row's score slot.
    __aicore__ inline void VariableRowSort(
        LocalTensor<half> &input, LocalTensor<half> &candidates,
        LocalTensor<float> &fastFloat, LocalTensor<float> &fastSort,
        LocalTensor<float> &fastSortB, LocalTensor<uint32_t> &fastIndex,
        LocalTensor<float> &scores, uint32_t b, uint32_t candidateCount)
    {
        LocalTensor<half> sortSource = candidates[b * padded_];
        if (candidateCount < topk_) {
            candidateCount = padded_;
            sortSource = input[b * padded_];
        }
        uint32_t sortPadded = 32u;
        while (sortPadded < candidateCount) sortPadded *= 2u;
        Duplicate(fastFloat, kNegative, sortPadded);
        PipeBarrier<PIPE_V>();
        Cast(fastFloat, sortSource, RoundMode::CAST_NONE, candidateCount);
        PipeBarrier<PIPE_V>();
        Sort32<float>(fastSort, fastFloat, fastIndex,
                      static_cast<int32_t>(sortPadded / 32u));
        PipeBarrier<PIPE_V>();

        const uint32_t retained = scoreStride_;
        uint32_t length = retained < 32u ? retained : 32u;
        uint32_t lists = sortPadded / 32u;
        DataCopyParams initialCompact = {
            static_cast<uint16_t>(lists),
            static_cast<uint16_t>(length / 4u),
            static_cast<uint16_t>(8u - length / 4u), 0};
        DataCopy(fastSortB, fastSort, initialCompact);
        PipeBarrier<PIPE_V>();

        LocalTensor<float> sorted = fastSortB;
        LocalTensor<float> scratch = fastSort;
        while (lists > 1u) {
            const uint32_t fanIn = (lists & 3u) == 0u ? 4u : 2u;
            const uint32_t groups = lists / fanIn;
            MrgSort4Info params;
            params.elementLengths[0] = static_cast<uint16_t>(length);
            params.elementLengths[1] = static_cast<uint16_t>(length);
            params.elementLengths[2] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.elementLengths[3] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.ifExhaustedSuspension = false;
            params.validBit = fanIn == 4u ? 15 : 3;
            if (fanIn == 4u) {
                MrgSortSrcList<float> src;
                src.src1 = sorted[0];
                src.src2 = sorted[2u * length];
                src.src3 = sorted[4u * length];
                src.src4 = sorted[6u * length];
                params.repeatTimes = static_cast<uint16_t>(groups);
                MrgSort<float>(scratch, src, params);
            } else {
                params.repeatTimes = 1;
                const uint32_t groupFloats = 4u * length;
                for (uint32_t group = 0; group < groups; ++group) {
                    const uint32_t base = group * groupFloats;
                    MrgSortSrcList<float> src;
                    src.src1 = sorted[base];
                    src.src2 = sorted[base + 2u * length];
                    src.src3 = sorted[base];
                    src.src4 = sorted[base];
                    MrgSort<float>(scratch[base], src, params);
                }
            }
            PipeBarrier<PIPE_V>();
            const uint32_t merged = fanIn * length;
            const uint32_t nextLength = merged < retained ? merged : retained;
            const uint32_t sourceBlocks = fanIn * length / 4u;
            DataCopyParams compact = {
                static_cast<uint16_t>(groups),
                static_cast<uint16_t>(nextLength / 4u),
                static_cast<uint16_t>(sourceBlocks - nextLength / 4u), 0};
            DataCopy(sorted, scratch, compact);
            PipeBarrier<PIPE_V>();
            length = nextLength;
            lists = groups;
        }

        GatherMaskParams gather;
        gather.src0BlockStride = 1;
        gather.repeatTimes = 1;
        gather.src0RepeatStride = static_cast<uint16_t>(retained / 4u);
        gather.src1RepeatStride = 0;
        uint64_t gathered = 0;
        GatherMask(scores[b * scoreStride_], sorted,
                   static_cast<uint8_t>(1), true,
                   2u * retained, gather, gathered);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void Compute(uint32_t batch,
                                   LocalTensor<uint32_t> &fastIndex)
    {
        LocalTensor<half> input = inputQ_.DeQue<half>();
        LocalTensor<uint8_t> mask = maskBuf_.Get<uint8_t>();
        LocalTensor<half> candidates = candidateBuf_.Get<half>();
        LocalTensor<float> fastFloat = fastFloatBuf_.Get<float>();
        LocalTensor<float> fastSort = fastSortBuf_.Get<float>();
        LocalTensor<float> fastSortB = fastSortBBuf_.Get<float>();

        // Sentinel-fill the candidates buffer: gather writes only the
        // retained prefix of each row, and the fixed-capacity compaction
        // below may read up to cap_ slots (including alignment padding).
        // Without the fill, stale values from earlier batches would leak
        // into the sort and could displace real candidates.
        Duplicate(candidates, HalfFromBits(0xfc00u), batch * padded_);
        PipeBarrier<PIPE_V>();

        const uint32_t sampleOffset = 2u * (kSampleRank - 1u);
        for (uint32_t b = 0; b < batch; ++b) {
            Cast(fastFloat[b * 64u], input[b * padded_],
                 RoundMode::CAST_NONE, 32u);
            Cast(fastFloat[b * 64u + 32u], input[b * padded_ + 32u],
                 RoundMode::CAST_NONE, 32u);
        }
        PipeBarrier<PIPE_V>();
        Sort32<float>(fastSort, fastFloat, fastIndex,
                      static_cast<int32_t>(batch * 2u));
        PipeBarrier<PIPE_V>();
        const int32_t sampleEvent = static_cast<int32_t>(
            pipe_.FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(sampleEvent);
        WaitFlag<HardEvent::V_S>(sampleEvent);
        for (uint32_t b = 0; b < batch; ++b) {
            const float threshold0 =
                fastSort.GetValue(b * 128u + sampleOffset);
            const float threshold1 =
                fastSort.GetValue(b * 128u + 64u + sampleOffset);
            const half filterThreshold = static_cast<half>(
                threshold0 < threshold1 ? threshold0 : threshold1);
            CompareScalar(mask[b * maskStride_], input[b * padded_],
                          filterThreshold, CMPMODE::GE, padded_);
        }
        PipeBarrier<PIPE_V>();
        uint64_t counts[32];
        for (uint32_t b = 0; b < batch; ++b) {
            counts[b] = 0;
            GatherMask(candidates[b * padded_], input[b * padded_],
                mask[b * maskStride_].ReinterpretCast<uint16_t>(), true,
                padded_, {1, 1, 0, 0}, counts[b]);
        }
        const int32_t countEvent = static_cast<int32_t>(
            pipe_.FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(countEvent);
        WaitFlag<HardEvent::V_S>(countEvent);

        // Compact every row's candidates into the fixed cap_ layout, then
        // sort the whole batch in ONE Sort32: repeatTimes = batch * cap_/32
        // restores the cross-row pipeline that per-row variable-length
        // sorting destroyed.
        Duplicate(fastFloat, kNegative, batch * cap_);
        PipeBarrier<PIPE_V>();
        for (uint32_t b = 0; b < batch; ++b) {
            uint32_t n = static_cast<uint32_t>(counts[b]);
            uint32_t copyCount = n < cap_ ? n : cap_;
            copyCount = AlignHalf(copyCount);  // cap_ is a multiple of 16
            Cast(fastFloat[b * cap_], candidates[b * padded_],
                 RoundMode::CAST_NONE, copyCount);
        }
        PipeBarrier<PIPE_V>();
        Sort32<float>(fastSort, fastFloat, fastIndex,
                      static_cast<int32_t>(batch * cap_ / 32u));
        PipeBarrier<PIPE_V>();

        LocalTensor<float> scores = scoresBuf_.Get<float>();

        // Sort32 only sorts within each 32-element block; the row's top-k
        // needs a cross-block merge.  Reuse the proven pruned_pow2 merge
        // pattern, batched across all rows: compact the per-row runs, then
        // bounded four/two-way merges until one run per row remains.  The
        // merge processes every row; fallback rows overwrite their scores
        // in the per-row loop below.
        const uint32_t retained = scoreStride_;
        uint32_t length = retained < 32u ? retained : 32u;
        const uint32_t initialRuns = batch * (cap_ / 32u);
        DataCopyParams initialCompact = {
            static_cast<uint16_t>(initialRuns),
            static_cast<uint16_t>(length / 4u),
            static_cast<uint16_t>(8u - length / 4u), 0};
        DataCopy(fastSortB, fastSort, initialCompact);
        PipeBarrier<PIPE_V>();

        LocalTensor<float> sorted = fastSortB;
        LocalTensor<float> scratch = fastSort;
        uint32_t listsPerRow = cap_ / 32u;
        while (listsPerRow > 1u) {
            const uint32_t fanIn = (listsPerRow & 3u) == 0u ? 4u : 2u;
            const uint32_t groupsPerRow = listsPerRow / fanIn;
            const uint32_t totalGroups = batch * groupsPerRow;
            MrgSort4Info params;
            params.elementLengths[0] = static_cast<uint16_t>(length);
            params.elementLengths[1] = static_cast<uint16_t>(length);
            params.elementLengths[2] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.elementLengths[3] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.ifExhaustedSuspension = false;
            params.validBit = fanIn == 4u ? 15 : 3;
            if (fanIn == 4u) {
                MrgSortSrcList<float> lists;
                lists.src1 = sorted[0];
                lists.src2 = sorted[2u * length];
                lists.src3 = sorted[4u * length];
                lists.src4 = sorted[6u * length];
                params.repeatTimes = static_cast<uint16_t>(totalGroups);
                MrgSort<float>(scratch, lists, params);
            } else {
                params.repeatTimes = 1;
                const uint32_t groupFloats = 4u * length;
                for (uint32_t group = 0; group < totalGroups; ++group) {
                    const uint32_t base = group * groupFloats;
                    MrgSortSrcList<float> lists;
                    lists.src1 = sorted[base];
                    lists.src2 = sorted[base + 2u * length];
                    lists.src3 = sorted[base];
                    lists.src4 = sorted[base];
                    MrgSort<float>(scratch[base], lists, params);
                }
            }
            PipeBarrier<PIPE_V>();
            const uint32_t mergedLength = fanIn * length;
            const uint32_t nextLength =
                mergedLength < retained ? mergedLength : retained;
            const uint32_t sourceBlocks = fanIn * length / 4u;
            DataCopyParams compact = {
                static_cast<uint16_t>(totalGroups),
                static_cast<uint16_t>(nextLength / 4u),
                static_cast<uint16_t>(sourceBlocks - nextLength / 4u), 0};
            DataCopy(sorted, scratch, compact);
            PipeBarrier<PIPE_V>();
            length = nextLength;
            listsPerRow = groupsPerRow;
        }

        // Batched gather over the packed merged rows; fallback rows are
        // overwritten by VariableRowSort in the per-row loop below.
        GatherMaskParams gather;
        gather.src0BlockStride = 1;
        gather.repeatTimes = static_cast<uint16_t>(batch);
        gather.src0RepeatStride = static_cast<uint16_t>(retained / 4u);
        gather.src1RepeatStride = 0;
        uint64_t gathered = 0;
        GatherMask(scores, sorted, static_cast<uint8_t>(1), true,
                   2u * retained, gather, gathered);
        PipeBarrier<PIPE_V>();

        for (uint32_t b = 0; b < batch; ++b) {
            uint32_t candidateCount = static_cast<uint32_t>(counts[b]);
            if (candidateCount >= topk_ && candidateCount <= cap_) {
                continue;
            }
            // Too few candidates (count < k): the threshold was too high,
            // redo the row with a full sort.  Too many (count > cap_):
            // candidates cannot be truncated while unsorted; sort only the
            // gathered prefix (every value below the threshold is provably
            // outside the top-k).
            VariableRowSort(input, candidates, fastFloat, fastSort,
                            fastSortB, fastIndex, scores, b, candidateCount);
        }

        LocalTensor<float> mathA = mathABuf_.Get<float>();
        LocalTensor<float> mathB = mathBBuf_.Get<float>();
        const uint32_t mathCount = batch * scoreStride_;
        Abs(mathA, scores, mathCount);
        PipeBarrier<PIPE_V>();
        Muls(mathB, mathA, -1.0F, mathCount);
        PipeBarrier<PIPE_V>();
        Exp(mathA, mathB, mathCount);
        PipeBarrier<PIPE_V>();
        Adds(mathB, mathA, 1.0F, mathCount);
        PipeBarrier<PIPE_V>();
        Log(mathA, mathB, mathCount);
        PipeBarrier<PIPE_V>();
        Maxs(mathB, scores, 0.0F, mathCount);
        PipeBarrier<PIPE_V>();
        Add(scores, mathB, mathA, mathCount);
        PipeBarrier<PIPE_V>();
        Sqrt(mathB, scores, mathCount);
        PipeBarrier<PIPE_V>();
        LocalTensor<half> output = outputQ_.AllocTensor<half>();
        for (uint32_t b = 0; b < batch; ++b) {
            Cast(output[b * outputStride_], mathB[b * scoreStride_],
                 RoundMode::CAST_NONE, scoreStride_);
        }
        outputQ_.EnQue(output);
        inputQ_.FreeTensor(input);
    }

    __aicore__ inline void CopyOut(uint32_t row, uint32_t batch)
    {
        LocalTensor<half> output = outputQ_.DeQue<half>();
        DataCopyExtParams copy = {
            static_cast<uint16_t>(batch),
            static_cast<uint32_t>(topk_ * sizeof(half)), 0, 0, 0};
        DataCopyPad(output_[static_cast<uint64_t>(row) * topk_], output, copy);
        outputQ_.FreeTensor(output);
    }

    uint32_t rows_ = 0;
    uint32_t experts_ = 0;
    uint32_t topk_ = 0;
    uint32_t padded_ = 0;
    uint32_t outputStride_ = 0;
    uint32_t scoreStride_ = 0;
    uint32_t maskStride_ = 0;
    uint32_t batchRows_ = 0;
    uint32_t cap_ = 0;
    GlobalTensor<half> input_;
    GlobalTensor<half> output_;
    TPipe pipe_;
    TQue<TPosition::VECIN, 2> inputQ_;
    TQue<TPosition::VECOUT, 1> outputQ_;
    TBuf<TPosition::VECCALC> maskBuf_, candidateBuf_;
    TBuf<TPosition::VECCALC> fastFloatBuf_, fastSortBuf_, fastSortBBuf_, fastIndexBuf_;
    TBuf<TPosition::VECCALC> scoresBuf_, mathABuf_, mathBBuf_;
};

__aicore__ inline void Run(GM_ADDR input, GM_ADDR output, uint32_t rows,
                           uint32_t experts, uint32_t topk)
{
    Kernel op;
    op.Init(input, output, rows, experts, topk);
    op.Process();
}
} // namespace sqrtsoftplus_fixedcap_half

// FP32 fixed-capacity adaptive filter, same structure as the FP16 path.
namespace sqrtsoftplus_fixedcap_float {
using namespace AscendC;

constexpr float kNegative = -3.402823466e+38F;
constexpr uint32_t kSampleRank = 4u;

__aicore__ inline uint32_t AlignFloat(uint32_t n)
{
    return (n + 7u) & ~7u;
}

class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                uint32_t rows, uint32_t experts, uint32_t topk)
    {
        rows_ = rows;
        experts_ = experts;
        topk_ = topk;
        padded_ = 128u;
        while (padded_ < experts_) padded_ *= 2u;
        outputStride_ = AlignFloat(topk_);
        scoreStride_ = AlignFloat(topk_);
        maskStride_ = ((padded_ + 255u) / 256u) * 32u;
        batchRows_ = 8192u / padded_;
        if (batchRows_ > 32u) batchRows_ = 32u;
        const uint32_t rowsPerCore =
            (rows_ + GetBlockNum() - 1u) / GetBlockNum();
        if (batchRows_ > rowsPerCore) batchRows_ = rowsPerCore;
        if (batchRows_ == 0u) batchRows_ = 1u;
        const uint32_t tile = batchRows_ * padded_;
        const uint32_t scoreTile = batchRows_ * scoreStride_;

        if (experts_ == 256u && topk_ == 16u) {
            cap_ = 64u;
        } else if (experts_ == 512u && topk_ == 32u) {
            cap_ = 128u;
        } else {
            cap_ = 256u;
        }

        input_.SetGlobalBuffer((__gm__ float *)input,
                               static_cast<uint64_t>(rows_) * experts_);
        output_.SetGlobalBuffer((__gm__ float *)output,
                                static_cast<uint64_t>(rows_) * topk_);
        pipe_.InitBuffer(inputQ_, 2, tile * sizeof(float));
        pipe_.InitBuffer(outputQ_, 1,
                         batchRows_ * outputStride_ * sizeof(float));
        pipe_.InitBuffer(maskBuf_, batchRows_ * maskStride_);
        pipe_.InitBuffer(candidateBuf_, tile * sizeof(float));
        pipe_.InitBuffer(fastFloatBuf_, batchRows_ * cap_ * sizeof(float));
        pipe_.InitBuffer(fastSortBuf_, 2u * batchRows_ * cap_ * sizeof(float));
        pipe_.InitBuffer(fastSortBBuf_, 2u * batchRows_ * cap_ * sizeof(float));
        pipe_.InitBuffer(fastIndexBuf_, batchRows_ * cap_ * sizeof(uint32_t));
        pipe_.InitBuffer(scoresBuf_, scoreTile * sizeof(float));
        pipe_.InitBuffer(mathABuf_, scoreTile * sizeof(float));
        pipe_.InitBuffer(mathBBuf_, scoreTile * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // One progression serves the sample sort, the fixed-capacity sort,
        // and the per-row fallback sort (prefixes of 0..batchRows_*cap_).
        LocalTensor<uint32_t> fastIndex = fastIndexBuf_.Get<uint32_t>();
        ArithProgression<int32_t>(fastIndex.ReinterpretCast<int32_t>(), 0, 1,
                                  static_cast<int32_t>(batchRows_ * cap_));
        PipeBarrier<PIPE_V>();
        // Software-pipelined loop over row batches: with a depth-2 input
        // queue, CopyIn(batch i+1) runs while Compute/CopyOut(batch i)
        // executes, hiding the row DMA behind the sort work.
        const uint32_t step = GetBlockNum() * batchRows_;
        uint32_t row = GetBlockIdx() * batchRows_;
        if (row >= rows_) return;
        const uint32_t firstRemain = rows_ - row;
        CopyIn(row, firstRemain < batchRows_ ? firstRemain : batchRows_);
        for (;;) {
            const uint32_t remain = rows_ - row;
            const uint32_t batch = remain < batchRows_ ? remain : batchRows_;
            const uint32_t nextRow = row + step;
            if (nextRow < rows_) {
                const uint32_t nextRemain = rows_ - nextRow;
                const uint32_t nextBatch =
                    nextRemain < batchRows_ ? nextRemain : batchRows_;
                CopyIn(nextRow, nextBatch);
            }
            Compute(batch, fastIndex);
            CopyOut(row, batch);
            if (nextRow >= rows_) break;
            row = nextRow;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t row, uint32_t batch)
    {
        LocalTensor<float> local = inputQ_.AllocTensor<float>();
        Duplicate(local, kNegative, batch * padded_);
        const int32_t event = static_cast<int32_t>(
            pipe_.FetchEventID(HardEvent::V_MTE2));
        SetFlag<HardEvent::V_MTE2>(event);
        WaitFlag<HardEvent::V_MTE2>(event);
        const uint32_t aligned = AlignFloat(experts_);
        DataCopyExtParams copy = {
            static_cast<uint16_t>(batch),
            static_cast<uint32_t>(experts_ * sizeof(float)), 0,
            static_cast<uint32_t>((padded_ - aligned) * sizeof(float) / 32u), 0};
        DataCopyPadExtParams<float> pad = {
            true, 0, static_cast<uint8_t>(aligned - experts_),
            kNegative};
        DataCopyPad(local, input_[static_cast<uint64_t>(row) * experts_],
                    copy, pad);
        inputQ_.EnQue(local);
    }

    __aicore__ inline void VariableRowSort(
        LocalTensor<float> &input, LocalTensor<float> &candidates,
        LocalTensor<float> &fastFloat, LocalTensor<float> &fastSort,
        LocalTensor<float> &fastSortB, LocalTensor<uint32_t> &fastIndex,
        LocalTensor<float> &scores, uint32_t b, uint32_t candidateCount)
    {
        LocalTensor<float> sortSource = candidates[b * padded_];
        if (candidateCount < topk_) {
            candidateCount = padded_;
            sortSource = input[b * padded_];
        }
        uint32_t sortPadded = 32u;
        while (sortPadded < candidateCount) sortPadded *= 2u;
        Duplicate(fastFloat, kNegative, sortPadded);
        PipeBarrier<PIPE_V>();
        Adds(fastFloat, sortSource, 0.0F, candidateCount);
        PipeBarrier<PIPE_V>();
        Sort32<float>(fastSort, fastFloat, fastIndex,
                      static_cast<int32_t>(sortPadded / 32u));
        PipeBarrier<PIPE_V>();

        const uint32_t retained = scoreStride_;
        uint32_t length = retained < 32u ? retained : 32u;
        uint32_t lists = sortPadded / 32u;
        DataCopyParams initialCompact = {
            static_cast<uint16_t>(lists),
            static_cast<uint16_t>(length / 4u),
            static_cast<uint16_t>(8u - length / 4u), 0};
        DataCopy(fastSortB, fastSort, initialCompact);
        PipeBarrier<PIPE_V>();

        LocalTensor<float> sorted = fastSortB;
        LocalTensor<float> scratch = fastSort;
        while (lists > 1u) {
            const uint32_t fanIn = (lists & 3u) == 0u ? 4u : 2u;
            const uint32_t groups = lists / fanIn;
            MrgSort4Info params;
            params.elementLengths[0] = static_cast<uint16_t>(length);
            params.elementLengths[1] = static_cast<uint16_t>(length);
            params.elementLengths[2] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.elementLengths[3] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.ifExhaustedSuspension = false;
            params.validBit = fanIn == 4u ? 15 : 3;
            if (fanIn == 4u) {
                MrgSortSrcList<float> src;
                src.src1 = sorted[0];
                src.src2 = sorted[2u * length];
                src.src3 = sorted[4u * length];
                src.src4 = sorted[6u * length];
                params.repeatTimes = static_cast<uint16_t>(groups);
                MrgSort<float>(scratch, src, params);
            } else {
                params.repeatTimes = 1;
                const uint32_t groupFloats = 4u * length;
                for (uint32_t group = 0; group < groups; ++group) {
                    const uint32_t base = group * groupFloats;
                    MrgSortSrcList<float> src;
                    src.src1 = sorted[base];
                    src.src2 = sorted[base + 2u * length];
                    src.src3 = sorted[base];
                    src.src4 = sorted[base];
                    MrgSort<float>(scratch[base], src, params);
                }
            }
            PipeBarrier<PIPE_V>();
            const uint32_t merged = fanIn * length;
            const uint32_t nextLength = merged < retained ? merged : retained;
            const uint32_t sourceBlocks = fanIn * length / 4u;
            DataCopyParams compact = {
                static_cast<uint16_t>(groups),
                static_cast<uint16_t>(nextLength / 4u),
                static_cast<uint16_t>(sourceBlocks - nextLength / 4u), 0};
            DataCopy(sorted, scratch, compact);
            PipeBarrier<PIPE_V>();
            length = nextLength;
            lists = groups;
        }

        GatherMaskParams gather;
        gather.src0BlockStride = 1;
        gather.repeatTimes = 1;
        gather.src0RepeatStride = static_cast<uint16_t>(retained / 4u);
        gather.src1RepeatStride = 0;
        uint64_t gathered = 0;
        GatherMask(scores[b * scoreStride_], sorted,
                   static_cast<uint8_t>(1), true,
                   2u * retained, gather, gathered);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void Compute(uint32_t batch,
                                   LocalTensor<uint32_t> &fastIndex)
    {
        LocalTensor<float> input = inputQ_.DeQue<float>();
        LocalTensor<uint8_t> mask = maskBuf_.Get<uint8_t>();
        LocalTensor<float> candidates = candidateBuf_.Get<float>();
        LocalTensor<float> fastFloat = fastFloatBuf_.Get<float>();
        LocalTensor<float> fastSort = fastSortBuf_.Get<float>();
        LocalTensor<float> fastSortB = fastSortBBuf_.Get<float>();

        Duplicate(candidates, kNegative, batch * padded_);
        PipeBarrier<PIPE_V>();

        const uint32_t sampleOffset = 2u * (kSampleRank - 1u);
        for (uint32_t b = 0; b < batch; ++b) {
            DataCopy(fastFloat[b * 64u], input[b * padded_], 32u);
            DataCopy(fastFloat[b * 64u + 32u],
                     input[b * padded_ + 32u], 32u);
        }
        PipeBarrier<PIPE_V>();
        Sort32<float>(fastSort, fastFloat, fastIndex,
                      static_cast<int32_t>(batch * 2u));
        PipeBarrier<PIPE_V>();
        const int32_t sampleEvent = static_cast<int32_t>(
            pipe_.FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(sampleEvent);
        WaitFlag<HardEvent::V_S>(sampleEvent);
        for (uint32_t b = 0; b < batch; ++b) {
            const float threshold0 =
                fastSort.GetValue(b * 128u + sampleOffset);
            const float threshold1 =
                fastSort.GetValue(b * 128u + 64u + sampleOffset);
            const float filterThreshold =
                threshold0 < threshold1 ? threshold0 : threshold1;
            CompareScalar(mask[b * maskStride_], input[b * padded_],
                          filterThreshold, CMPMODE::GE, padded_);
        }
        PipeBarrier<PIPE_V>();
        uint64_t counts[32];
        for (uint32_t b = 0; b < batch; ++b) {
            counts[b] = 0;
            GatherMask(candidates[b * padded_], input[b * padded_],
                mask[b * maskStride_].ReinterpretCast<uint32_t>(), true,
                padded_, {1, 1, 0, 0}, counts[b]);
        }
        const int32_t countEvent = static_cast<int32_t>(
            pipe_.FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(countEvent);
        WaitFlag<HardEvent::V_S>(countEvent);

        Duplicate(fastFloat, kNegative, batch * cap_);
        PipeBarrier<PIPE_V>();
        for (uint32_t b = 0; b < batch; ++b) {
            uint32_t n = static_cast<uint32_t>(counts[b]);
            uint32_t copyCount = n < cap_ ? n : cap_;
            copyCount = AlignFloat(copyCount);  // cap_ is a multiple of 8
            DataCopy(fastFloat[b * cap_], candidates[b * padded_],
                     copyCount);
        }
        PipeBarrier<PIPE_V>();
        Sort32<float>(fastSort, fastFloat, fastIndex,
                      static_cast<int32_t>(batch * cap_ / 32u));
        PipeBarrier<PIPE_V>();

        LocalTensor<float> scores = scoresBuf_.Get<float>();

        // Sort32 only sorts within each 32-element block; the row's top-k
        // needs a cross-block merge.  Reuse the proven pruned_pow2 merge
        // pattern, batched across all rows: compact the per-row runs, then
        // bounded four/two-way merges until one run per row remains.  The
        // merge processes every row; fallback rows overwrite their scores
        // in the per-row loop below.
        const uint32_t retained = scoreStride_;
        uint32_t length = retained < 32u ? retained : 32u;
        const uint32_t initialRuns = batch * (cap_ / 32u);
        DataCopyParams initialCompact = {
            static_cast<uint16_t>(initialRuns),
            static_cast<uint16_t>(length / 4u),
            static_cast<uint16_t>(8u - length / 4u), 0};
        DataCopy(fastSortB, fastSort, initialCompact);
        PipeBarrier<PIPE_V>();

        LocalTensor<float> sorted = fastSortB;
        LocalTensor<float> scratch = fastSort;
        uint32_t listsPerRow = cap_ / 32u;
        while (listsPerRow > 1u) {
            const uint32_t fanIn = (listsPerRow & 3u) == 0u ? 4u : 2u;
            const uint32_t groupsPerRow = listsPerRow / fanIn;
            const uint32_t totalGroups = batch * groupsPerRow;
            MrgSort4Info params;
            params.elementLengths[0] = static_cast<uint16_t>(length);
            params.elementLengths[1] = static_cast<uint16_t>(length);
            params.elementLengths[2] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.elementLengths[3] = fanIn == 4u
                ? static_cast<uint16_t>(length) : 0;
            params.ifExhaustedSuspension = false;
            params.validBit = fanIn == 4u ? 15 : 3;
            if (fanIn == 4u) {
                MrgSortSrcList<float> lists;
                lists.src1 = sorted[0];
                lists.src2 = sorted[2u * length];
                lists.src3 = sorted[4u * length];
                lists.src4 = sorted[6u * length];
                params.repeatTimes = static_cast<uint16_t>(totalGroups);
                MrgSort<float>(scratch, lists, params);
            } else {
                params.repeatTimes = 1;
                const uint32_t groupFloats = 4u * length;
                for (uint32_t group = 0; group < totalGroups; ++group) {
                    const uint32_t base = group * groupFloats;
                    MrgSortSrcList<float> lists;
                    lists.src1 = sorted[base];
                    lists.src2 = sorted[base + 2u * length];
                    lists.src3 = sorted[base];
                    lists.src4 = sorted[base];
                    MrgSort<float>(scratch[base], lists, params);
                }
            }
            PipeBarrier<PIPE_V>();
            const uint32_t mergedLength = fanIn * length;
            const uint32_t nextLength =
                mergedLength < retained ? mergedLength : retained;
            const uint32_t sourceBlocks = fanIn * length / 4u;
            DataCopyParams compact = {
                static_cast<uint16_t>(totalGroups),
                static_cast<uint16_t>(nextLength / 4u),
                static_cast<uint16_t>(sourceBlocks - nextLength / 4u), 0};
            DataCopy(sorted, scratch, compact);
            PipeBarrier<PIPE_V>();
            length = nextLength;
            listsPerRow = groupsPerRow;
        }

        // Batched gather over the packed merged rows; fallback rows are
        // overwritten by VariableRowSort in the per-row loop below.
        GatherMaskParams gather;
        gather.src0BlockStride = 1;
        gather.repeatTimes = static_cast<uint16_t>(batch);
        gather.src0RepeatStride = static_cast<uint16_t>(retained / 4u);
        gather.src1RepeatStride = 0;
        uint64_t gathered = 0;
        GatherMask(scores, sorted, static_cast<uint8_t>(1), true,
                   2u * retained, gather, gathered);
        PipeBarrier<PIPE_V>();

        for (uint32_t b = 0; b < batch; ++b) {
            uint32_t candidateCount = static_cast<uint32_t>(counts[b]);
            if (candidateCount >= topk_ && candidateCount <= cap_) {
                continue;
            }
            // Too few candidates (count < k): the threshold was too high,
            // redo the row with a full sort.  Too many (count > cap_):
            // candidates cannot be truncated while unsorted; sort only the
            // gathered prefix (every value below the threshold is provably
            // outside the top-k).
            VariableRowSort(input, candidates, fastFloat, fastSort,
                            fastSortB, fastIndex, scores, b, candidateCount);
        }

        LocalTensor<float> mathA = mathABuf_.Get<float>();
        LocalTensor<float> mathB = mathBBuf_.Get<float>();
        const uint32_t mathCount = batch * scoreStride_;
        Abs(mathA, scores, mathCount);
        PipeBarrier<PIPE_V>();
        Muls(mathB, mathA, -1.0F, mathCount);
        PipeBarrier<PIPE_V>();
        Exp(mathA, mathB, mathCount);
        PipeBarrier<PIPE_V>();
        Adds(mathB, mathA, 1.0F, mathCount);
        PipeBarrier<PIPE_V>();
        Log(mathA, mathB, mathCount);
        PipeBarrier<PIPE_V>();
        Maxs(mathB, scores, 0.0F, mathCount);
        PipeBarrier<PIPE_V>();
        Add(scores, mathB, mathA, mathCount);
        PipeBarrier<PIPE_V>();
        Sqrt(mathB, scores, mathCount);
        PipeBarrier<PIPE_V>();
        LocalTensor<float> output = outputQ_.AllocTensor<float>();
        for (uint32_t b = 0; b < batch; ++b) {
            DataCopy(output[b * outputStride_], mathB[b * scoreStride_],
                     scoreStride_);
        }
        outputQ_.EnQue(output);
        inputQ_.FreeTensor(input);
    }

    __aicore__ inline void CopyOut(uint32_t row, uint32_t batch)
    {
        LocalTensor<float> output = outputQ_.DeQue<float>();
        DataCopyExtParams copy = {
            static_cast<uint16_t>(batch),
            static_cast<uint32_t>(topk_ * sizeof(float)), 0, 0, 0};
        DataCopyPad(output_[static_cast<uint64_t>(row) * topk_], output, copy);
        outputQ_.FreeTensor(output);
    }

    uint32_t rows_ = 0;
    uint32_t experts_ = 0;
    uint32_t topk_ = 0;
    uint32_t padded_ = 0;
    uint32_t outputStride_ = 0;
    uint32_t scoreStride_ = 0;
    uint32_t maskStride_ = 0;
    uint32_t batchRows_ = 0;
    uint32_t cap_ = 0;
    GlobalTensor<float> input_;
    GlobalTensor<float> output_;
    TPipe pipe_;
    TQue<TPosition::VECIN, 2> inputQ_;
    TQue<TPosition::VECOUT, 1> outputQ_;
    TBuf<TPosition::VECCALC> maskBuf_, candidateBuf_;
    TBuf<TPosition::VECCALC> fastFloatBuf_, fastSortBuf_, fastSortBBuf_, fastIndexBuf_;
    TBuf<TPosition::VECCALC> scoresBuf_, mathABuf_, mathBBuf_;
};

__aicore__ inline void Run(GM_ADDR input, GM_ADDR output, uint32_t rows,
                           uint32_t experts, uint32_t topk)
{
    Kernel op;
    op.Init(input, output, rows, experts, topk);
    op.Process();
}
} // namespace sqrtsoftplus_fixedcap_float

extern "C" __global__ __aicore__ void sqrt_softplus_top_k_f32(
    GM_ADDR input, GM_ADDR output, uint32_t rows, uint32_t experts, uint32_t topk)
{
    sqrtsoftplus_pruned_pow2::Run<float>(input, output, rows, experts, topk);
}

extern "C" __global__ __aicore__ void sqrt_softplus_top_k_f32_filter(
    GM_ADDR input, GM_ADDR output, uint32_t rows, uint32_t experts, uint32_t topk)
{
    sqrtsoftplus_fixedcap_float::Run(input, output, rows, experts, topk);
}

extern "C" __global__ __aicore__ void sqrt_softplus_top_k_f16(
    GM_ADDR input, GM_ADDR output, uint32_t rows, uint32_t experts, uint32_t topk)
{
    sqrtsoftplus_pruned_pow2::Run<half>(input, output, rows, experts, topk);
}

extern "C" __global__ __aicore__ void sqrt_softplus_top_k_f16_filter(
    GM_ADDR input, GM_ADDR output, uint32_t rows, uint32_t experts, uint32_t topk)
{
    sqrtsoftplus_fixedcap_half::Run(input, output, rows, experts, topk);
}

extern "C" void run_kernel(GM_ADDR router_logits,
                            const TensorGroupInfo &info_router_logits,
                            GM_ADDR topk_scores,
                            const TensorGroupInfo &info_topk_scores,
                            int64_t availableCoreNum, aclrtStream stream,
                            int64_t k)
{
    (void)info_topk_scores;
    const TensorInfo &inputInfo = info_router_logits.tensors[0];
    const uint32_t rows = static_cast<uint32_t>(inputInfo.shape[0]);
    const uint32_t experts = static_cast<uint32_t>(inputInfo.shape[1]);
    const uint32_t topk = static_cast<uint32_t>(k);
    if (rows == 0u || topk == 0u) return;
    uint32_t blocks = availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1u;
    if (blocks > rows) blocks = rows;
    if (inputInfo.dtype == 1) {
        if (experts == 512u && topk == 32u) {
            sqrt_softplus_top_k_f16_filter<<<blocks, nullptr, stream>>>(
                router_logits, topk_scores, rows, experts, topk);
        } else {
            sqrt_softplus_top_k_f16<<<blocks, nullptr, stream>>>(
                router_logits, topk_scores, rows, experts, topk);
        }
    } else {
        if (experts == 1024u && topk == 64u) {
            sqrt_softplus_top_k_f32_filter<<<blocks, nullptr, stream>>>(
                router_logits, topk_scores, rows, experts, topk);
        } else {
            sqrt_softplus_top_k_f32<<<blocks, nullptr, stream>>>(
                router_logits, topk_scores, rows, experts, topk);
        }
    }
}
